APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Horizon needs QUEUE_CONNECTION=redis
QUEUE_CONNECTION=database

CACHE_STORE=array
# CACHE_PREFIX=

# The response cache needs a store with tags (redis in production)
RESPONSE_CACHE_DRIVER=array

SETTINGS_CACHE_ENABLED=false

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

OCTANE_SERVER=frankenphp

# database searches the columns directly; switch to typesense, meilisearch or algolia when needed
SCOUT_DRIVER=database
SCOUT_QUEUE=false

# HEALTH_SECRET_TOKEN=

TELESCOPE_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"

# INERTIA_SSR_ENABLED=false
